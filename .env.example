# Copy this file to .env.local (or .env.staging, .env.prod) and fill in real values.
# Never commit actual .env* files (see .gitignore) — only this .env.example is tracked.

# ---- Application under test ----
BASE_URL=https://your-app-staging.example.com
API_BASE_URL=https://api-staging.example.com

# ---- Auth / test users (use dedicated QA accounts, never real prod users) ----
TEST_USER_EMAIL=qa.tester@example.com
TEST_USER_PASSWORD=change_me
ADMIN_USER_EMAIL=qa.admin@example.com
ADMIN_USER_PASSWORD=change_me

# ---- API auth ----
API_KEY=your_api_key_here
API_BEARER_TOKEN=

# ---- Claude / MCP / self-healing tier-2 (AI fallback) ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
CLAUDE_HEALING_MODEL=claude-haiku-5-5
ENABLE_AI_HEALING=true
HEALING_SIMILARITY_THRESHOLD=0.80

# ---- Run environment selector (local | staging | prod) ----
ENV=local

# ---- CI-only (set as GitHub Actions secrets, not here) ----
# SLACK_WEBHOOK_URL=
# REPORT_PORTAL_TOKEN=
